{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitroll.dev/curriculum/challenges/regulatory-compliance/snapshot.schema.json",
  "title": "Regulatory Compliance Stage Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "snapshot_id", "run_id", "stage", "sequence", "created_at", "status", "predecessor", "consumed_record_ids", "produced_record_ids", "state", "unresolved", "decisions"],
  "properties": {
    "schema_version": {"const": "regulatory-compliance-stage-snapshot/2"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["scope", "source-capture", "authority-and-timing", "evidence-reconciliation", "impact-analysis", "actions-and-approvals", "publication-validation"]},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 7},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "partial", "blocked", "failed"]},
    "predecessor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/predecessor"}]},
    "consumed_record_ids": {"$ref": "#/$defs/recordIds"},
    "produced_record_ids": {"$ref": "#/$defs/recordIds"},
    "state": {"type": "object", "additionalProperties": true},
    "unresolved": {"$ref": "#/$defs/records"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decisionRecord"}}
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"predecessor": {"type": "null"}, "consumed_record_ids": {"maxItems": 0}}},
      "else": {"properties": {"predecessor": {"$ref": "#/$defs/predecessor"}, "consumed_record_ids": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"stage": {"const": "scope"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 1}, "state": {"required": ["as_of", "review_type", "systems_in_scope", "audiences", "approval_gates"], "properties": {"as_of": {"type": "string", "format": "date-time"}, "review_type": {"type": "string", "minLength": 1}, "systems_in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "approval_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "source-capture"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 2}, "state": {"required": ["sources"], "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRecord"}}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "authority-and-timing"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 3}, "state": {"required": ["binding_rules", "timing_rules", "guidance_context", "authority_blockers"], "properties": {"binding_rules": {"$ref": "#/$defs/records"}, "timing_rules": {"$ref": "#/$defs/records"}, "guidance_context": {"$ref": "#/$defs/records"}, "authority_blockers": {"$ref": "#/$defs/records"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "evidence-reconciliation"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 4}, "state": {"required": ["system_facts", "policy_controls", "incident_evidence", "conflicts", "evidence_gaps"], "properties": {"system_facts": {"$ref": "#/$defs/records"}, "policy_controls": {"$ref": "#/$defs/records"}, "incident_evidence": {"$ref": "#/$defs/records"}, "conflicts": {"$ref": "#/$defs/records"}, "evidence_gaps": {"$ref": "#/$defs/records"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "impact-analysis"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 5}, "state": {"required": ["impacts", "unaffected_items", "conflicts", "unresolved_items"], "properties": {"impacts": {"type": "array", "items": {"$ref": "#/$defs/impactRecord"}}, "unaffected_items": {"$ref": "#/$defs/records"}, "conflicts": {"$ref": "#/$defs/records"}, "unresolved_items": {"$ref": "#/$defs/records"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "actions-and-approvals"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 6}, "state": {"required": ["proposed_actions", "approval_requirements", "escalations"], "properties": {"proposed_actions": {"$ref": "#/$defs/records"}, "approval_requirements": {"type": "array", "items": {"$ref": "#/$defs/approvalRecord"}}, "escalations": {"$ref": "#/$defs/records"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "publication-validation"}}, "required": ["stage"]},
      "then": {"properties": {"sequence": {"const": 7}, "state": {"required": ["artifacts", "validation_checks", "publication_status"], "properties": {"artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRecord"}}, "validation_checks": {"$ref": "#/$defs/records"}, "publication_status": {"enum": ["validated", "blocked", "failed"]}}}}}
    }
  ],
  "$defs": {
    "recordIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "path", "sha256"], "properties": {"snapshot_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "record": {"type": "object", "additionalProperties": true, "required": ["id", "summary", "evidence_ids"], "properties": {"id": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/recordIds"}, "owner": {"type": ["string", "null"]}, "rationale": {"type": ["string", "null"]}}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "sourceRecord": {"allOf": [{"$ref": "#/$defs/record"}, {"type": "object", "required": ["source_role", "authority", "locator", "retrieved_at", "retrieval_status", "content_type", "version_metadata", "content_hash", "local_reference"], "properties": {"source_role": {"enum": ["binding-regulation", "official-guidance", "internal-policy", "operational-record", "other"]}, "authority": {"enum": ["binding", "advisory", "internal-control", "operational-evidence", "unknown"]}, "locator": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "format": "date-time"}, "retrieval_status": {"enum": ["retrieved", "unavailable", "invalid", "unverified", "stale"]}, "content_type": {"type": "string", "minLength": 1}, "version_metadata": {"type": ["object", "null"]}, "content_hash": {"anyOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]}, "local_reference": {"type": ["string", "null"]}}}]},
    "impactRecord": {"allOf": [{"$ref": "#/$defs/record"}, {"type": "object", "required": ["state"], "properties": {"state": {"enum": ["supported-impact", "supported-no-impact", "conflicting", "unresolved"]}}}]},
    "approvalRecord": {"allOf": [{"$ref": "#/$defs/record"}, {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pending", "approved", "rejected", "not-required"]}}}]},
    "decisionRecord": {"allOf": [{"$ref": "#/$defs/record"}, {"type": "object", "required": ["rationale", "tradeoffs"], "properties": {"rationale": {"type": "string", "minLength": 1}, "tradeoffs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}]},
    "artifactRecord": {"type": "object", "additionalProperties": true, "required": ["id", "path", "sha256", "validation_status"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "validation_status": {"enum": ["valid", "invalid", "not-produced"]}}}
  }
}
